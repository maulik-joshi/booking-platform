############################
# Core Git Ignore Template #
############################

# OS-specific junk
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

############################
# VS Code & Dev Containers #
############################

# VS Code local settings
.vscode/
.vscode-server/
.vscode-remote/

# Dev Container generated files
devcontainer-lock.json

# Dev Container cache folders (optional but recommended)
.devcontainer/containers/
.devcontainer/cache/

############################
# Docker / Compose #
############################

# Docker build artifacts
docker-data/
docker-volume/
*.pid

# Ignore Docker Compose override files
docker-compose.override.yml

############################
# Node / React #
############################

node_modules/
dist/
build/
coverage/
npm-debug.log
yarn-error.log

############################
# .NET #
############################

# Build results
bin/
obj/
out/

# Visual Studio files
*.user
*.suo
*.cache
*.pdb
*.mdb
*.ilk
*.log

# NuGet packages
*.nupkg
packages/
*.snupkg

# ASP.NET publish output
wwwroot/

############################
# Terraform #
############################

# Local Terraform state
*.tfstate
*.tfstate.*
terraform.tfstate.backup

# Terraform crash logs
crash.log

# Terraform plan files
*.tfplan

# Terraform local directories
.terraform/
.terraform.lock.hcl

############################
# Azure DevOps / CI #
############################

# Pipeline artifacts
*.coverage
*.trx
TestResults/
artifacts/

############################
# Python (if ever used) #
############################

__pycache__/
*.pyc
*.pyo
*.pyd
*.pytest_cache/
*.mypy_cache/

############################
# Misc #
############################

# Temporary files
*.tmp
*.temp
*.bak

# IDE junk
.idea/
*.iml

# Local tooling
tools/
scripts/local/
